# Only needed if you replace the bundled `caddy` service with your own proxy.
# The stack's own Caddyfile lives inline in docker-compose.yml.
#
# There is no path splitting to replicate: the Go binary serves /v1, /agent,
# /healthz, /readyz, /docs, /openapi.yaml and /install.sh in-process and proxies
# everything else to the bundled dashboard. One upstream is the whole config.

db.example.com {
	encode zstd gzip
	reverse_proxy fleetdock:8080
}

# nginx equivalent:
#
# server {
#     server_name db.example.com;
#     location / {
#         proxy_pass http://fleetdock:8080;
#         proxy_set_header Host              $host;
#         proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#     }
# }
#
# Keep FLEETDOCK_TRUST_PROXY_HEADERS=true only while the API is reachable solely
# through the proxy. If port 8080 is also exposed, a client can spoof
# X-Forwarded-For and evade the login rate limiter.
