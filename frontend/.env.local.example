# The dashboard calls the API on its own origin, so nothing is required here.
#
# `npm run dev` proxies /v1, /agent, /healthz, /readyz, /docs, /openapi.yaml and
# /install.sh to the Go API via the rewrites in next.config.mjs. Point them
# somewhere other than http://127.0.0.1:8080 with:
# FLEETDOCK_DEV_API_URL=http://192.168.1.10:8080

# Only for split-origin deployments, where the dashboard and API are served from
# different hostnames. Must be a full origin, and requires rebuilding the bundle
# because Next inlines NEXT_PUBLIC_* at build time.
# NEXT_PUBLIC_API_URL=https://api.example.com
