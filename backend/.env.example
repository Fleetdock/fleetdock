# Copy to .env for local backend runs. Only MDCP_DATABASE_URL is required.
# Note: `go run` does not auto-load this file — export it first, e.g.:
#   export $(grep -v '^#' .env | xargs)

# Neon (or any PostgreSQL). Use sslmode=require for Neon.
MDCP_DATABASE_URL=postgres://<user>:<password>@<your-neon-host>.neon.tech/db_manager?sslmode=require

MDCP_HTTP_ADDR=:8080
MDCP_JWT_SECRET=dev-insecure-change-me
MDCP_ADMIN_EMAIL=admin@example.com
MDCP_ADMIN_PASSWORD=admin12345
MDCP_CORS_ORIGIN=http://localhost:3000
MDCP_RUN_MIGRATIONS=true
MDCP_SHUTDOWN_TIMEOUT=15s
MDCP_REQUEST_TIMEOUT=30s
