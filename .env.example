# Copy to .env and fill in. Used by docker compose (and handy for local dev).

# Neon (or any PostgreSQL) connection string. Use sslmode=require for Neon.
MDCP_DATABASE_URL=postgres://<user>:<password>@<your-neon-host>.neon.tech/db_manager?sslmode=require

# Sign a strong random secret in production.
MDCP_JWT_SECRET=change-me-in-production

# First-run bootstrap admin (only used when the users table is empty).
MDCP_ADMIN_EMAIL=admin@example.com
MDCP_ADMIN_PASSWORD=admin12345

# Origin the browser loads the frontend from (CORS).
MDCP_CORS_ORIGIN=http://localhost:3000

# Base URL the browser uses to reach the API (baked into the frontend build).
NEXT_PUBLIC_API_URL=http://localhost:8080
