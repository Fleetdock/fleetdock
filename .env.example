# Copy to .env and fill in. Used by docker compose (and handy for local dev).
#
# Generate secrets for local development:
#   cp .env.example .env
#   ./scripts/generate-secrets.sh >> .env

# Local Postgres (default for docker compose). For hosted Postgres (e.g. Neon),
# replace with your connection string and use sslmode=require.
FLEETDOCK_DATABASE_URL=postgres://fleetdock:fleetdock@postgres:5432/fleetdock?sslmode=disable

# Set to "production" on real deployments: the API then refuses to start if
# any of the secrets below still use their defaults.
FLEETDOCK_ENV=development

# Required — run ./scripts/generate-secrets.sh to generate strong values.
FLEETDOCK_JWT_SECRET=
FLEETDOCK_ENCRYPTION_KEY=

# First-run bootstrap admin (only used when the users table is empty).
FLEETDOCK_ADMIN_EMAIL=admin@example.com
FLEETDOCK_ADMIN_PASSWORD=

# Origin the browser loads the frontend from (CORS).
FLEETDOCK_CORS_ORIGIN=http://localhost:3000

# Set to true ONLY when the API runs behind a trusted reverse proxy that sets
# X-Forwarded-For. It makes the login rate limiter use that header for the
# client IP; leaving it false (the default) avoids clients spoofing the header.
FLEETDOCK_TRUST_PROXY_HEADERS=false

# Externally reachable base URL of the API. Used in the one-command agent
# install (curl -sSL $FLEETDOCK_PUBLIC_URL/install.sh | sudo env ... ), so it must be
# reachable from the servers you want to connect. Use localhost only when the agent
# runs on the same machine; for VMs/LAN dev use the host IP (e.g. http://192.168.x.x:8080).
FLEETDOCK_PUBLIC_URL=http://localhost:8080

# Base URL the browser uses to reach the API (baked into the frontend build).
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Optional: SMTP for email notification channels ---
# When FLEETDOCK_SMTP_HOST is empty, email delivery is disabled.
# FLEETDOCK_SMTP_HOST=smtp.example.com
# FLEETDOCK_SMTP_PORT=587
# FLEETDOCK_SMTP_USERNAME=
# FLEETDOCK_SMTP_PASSWORD=
# FLEETDOCK_SMTP_FROM=fleetdock@example.com

# --- Optional: worker tuning ---
# FLEETDOCK_WORKER_ENABLED=true
# FLEETDOCK_HEARTBEAT_TIMEOUT=2m
# FLEETDOCK_METRICS_RETENTION=168h

# --- External database access gateway (HAProxy) ---
# Enabled by default in docker compose, which ships the gateway container.
# A bare `api` binary has no gateway, so the code default is false.
# FLEETDOCK_GATEWAY_ENABLED=true
#
# Hostname clients connect to. DNS must resolve this to the gateway host, and
# it is baked into every connection URL at the moment public access is enabled.
# FLEETDOCK_GATEWAY_PUBLIC_HOST=gateway.example.com
#
# One public port per database. Must match the range published by the gateway
# container, or endpoints get ports that external clients cannot reach.
# FLEETDOCK_GATEWAY_PORT_RANGE_START=15432
# FLEETDOCK_GATEWAY_PORT_RANGE_END=15481
#
# Diagnostic port reporting the source address HAProxy observes, so users can
# discover what to allowlist: curl http://<public-host>:15431
# Must fall outside the range above. Set to 0 to disable.
# FLEETDOCK_GATEWAY_DIAG_PORT=15431
#
# "direct" trusts the TCP source address. Behind an L4 load balancer that
# address is the balancer's, so CIDR allowlists match nothing — use
# "proxy-protocol" there and enable PROXY protocol on the balancer.
# FLEETDOCK_GATEWAY_SOURCE_IP_MODE=direct
#
# Paths on the volume shared between the API and the gateway container.
# FLEETDOCK_GATEWAY_CONFIG_PATH=/var/lib/fleetdock/gateway/haproxy.cfg
# FLEETDOCK_GATEWAY_MASTER_SOCKET=/var/lib/fleetdock/gateway/haproxy-master.sock
# FLEETDOCK_GATEWAY_ADMIN_SOCKET=/var/lib/fleetdock/gateway/haproxy-admin.sock
