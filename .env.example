# Fleetdock configuration.
#
# A normal install does not need this file — `install.sh` writes /opt/fleetdock/.env
# for you. Copy this only when running the stack by hand:
#
#   cp .env.example .env
#   ./scripts/generate-secrets.sh >> .env
#   docker compose up -d

# --- the one setting that matters ---------------------------------------------
# The hostname the dashboard is served on. Everything else about addressing is
# derived from it: agents are told this URL, the browser calls the API here, and
# database endpoints are advertised on this name.
FLEETDOCK_DOMAIN=localhost

# Caddy's site address. A bare hostname gets an automatic TLS certificate; an
# explicit http:// URL serves plain HTTP and skips certificate issuance.
FLEETDOCK_SITE_ADDRESS=http://localhost

# The externally reachable base URL, scheme included. Must agree with the two
# above; install.sh keeps all three in step.
FLEETDOCK_PUBLIC_URL=http://localhost
FLEETDOCK_CORS_ORIGIN=http://localhost

# --- required secrets ---------------------------------------------------------
# Run ./scripts/generate-secrets.sh to produce strong values.
#
# FLEETDOCK_ENCRYPTION_KEY encrypts stored database and object-store credentials.
# Losing or changing it makes every one of them unreadable — back it up, and
# rotate it only through `make rotate-keys` (see docs/OPERATIONS.md).
FLEETDOCK_JWT_SECRET=
FLEETDOCK_ENCRYPTION_KEY=

# First-run bootstrap admin, used only while the users table is empty.
FLEETDOCK_ADMIN_EMAIL=admin@example.com
FLEETDOCK_ADMIN_PASSWORD=

# "production" refuses to start if any secret above is still a default.
FLEETDOCK_ENV=production

# Image tag to run.
FLEETDOCK_RELEASE_TAG=latest

# --- metadata database --------------------------------------------------------
# Defaults to the bundled Postgres container. For hosted Postgres (Neon, RDS,
# Cloud SQL), point this at it with sslmode=require and scale the bundled one to
# zero: docker compose up -d --scale postgres=0
# FLEETDOCK_DATABASE_URL=postgres://user:pass@db.example.com:5432/fleetdock?sslmode=require

# --- external database access (opt-in) ----------------------------------------
# Off by default: enabling it publishes a 50-port range on this host.
#   fleetdock gateway enable
# FLEETDOCK_GATEWAY_ENABLED=false
#
# Defaults to FLEETDOCK_DOMAIN — the gateway speaks raw TCP on its own ports and
# needs no DNS record of its own. Override it only when the main record cannot
# carry raw TCP, e.g. behind a Cloudflare-proxied ("orange cloud") record, which
# passes 80/443 only.
# FLEETDOCK_GATEWAY_PUBLIC_HOST=gw.example.com
#
# One public port per database. The published range and the allocator range come
# from these same variables, so widening one widens the other.
# FLEETDOCK_GATEWAY_PORT_RANGE_START=15432
# FLEETDOCK_GATEWAY_PORT_RANGE_END=15481
#
# Diagnostic port reporting the source address HAProxy observes, so you can
# discover what to allowlist: curl http://<public-host>:15431
# Must fall outside the range above. 0 disables it.
# FLEETDOCK_GATEWAY_DIAG_PORT=15431
#
# "direct" trusts the TCP source address. Behind an L4 load balancer that address
# is the balancer's, so CIDR allowlists match nothing — use "proxy-protocol"
# there and enable PROXY protocol on the balancer.
# FLEETDOCK_GATEWAY_SOURCE_IP_MODE=direct

# --- optional: SMTP for email notification channels ---------------------------
# Email delivery is disabled while FLEETDOCK_SMTP_HOST is empty.
# FLEETDOCK_SMTP_HOST=smtp.example.com
# FLEETDOCK_SMTP_PORT=587
# FLEETDOCK_SMTP_USERNAME=
# FLEETDOCK_SMTP_PASSWORD=
# FLEETDOCK_SMTP_FROM=fleetdock@example.com

# --- optional: worker tuning --------------------------------------------------
# FLEETDOCK_WORKER_ENABLED=true
# FLEETDOCK_HEARTBEAT_TIMEOUT=2m
# FLEETDOCK_METRICS_RETENTION=168h
