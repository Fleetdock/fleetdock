#!/bin/sh
# Day-2 operations for a Fleetdock install created by install.sh.
# Installed to /usr/local/bin/fleetdock.
set -eu

FLEETDOCK_DIR="${FLEETDOCK_DIR:-/opt/fleetdock}"
ENV_FILE="${FLEETDOCK_DIR}/.env"

[ -f "$ENV_FILE" ] || {
  printf 'error: no Fleetdock install at %s. Set FLEETDOCK_DIR, or install with:\n  curl -sSL https://fleetdock.dev/install.sh | sh\n' "$FLEETDOCK_DIR" >&2
  exit 1
}

dc() {
  docker compose --project-directory "$FLEETDOCK_DIR" --env-file "$ENV_FILE" "$@"
}

getenv() { grep "^$1=" "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true; }

setenv() {
  # $1 = key, $2 = value. Adds the key if it is not there yet.
  # Rewritten with awk rather than `sed -i`: BSD sed (macOS) has no bare -i,
  # and a value containing | & or \ would corrupt a sed replacement. The value
  # travels through the environment, which awk reads verbatim.
  tmp="$(mktemp "${ENV_FILE}.XXXXXX")"
  FD_KEY="$1" FD_VAL="$2" awk '
    BEGIN { k = ENVIRON["FD_KEY"]; v = ENVIRON["FD_VAL"]; done = 0 }
    index($0, k "=") == 1 { print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }
  ' "$ENV_FILE" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$ENV_FILE"
}

# uses_bundled_postgres reports whether metadata lives in the bundled
# postgres service (as opposed to a hosted database).
uses_bundled_postgres() {
  case "$(getenv FLEETDOCK_DATABASE_URL)" in
    ""|*@postgres:*) dc ps --services 2>/dev/null | grep -qx postgres ;;
    *) return 1 ;;
  esac
}

# backup_db writes a compressed pg_dump of the metadata database to $1.
backup_db() {
  out="$1"
  umask 077
  if uses_bundled_postgres; then
    dc exec -T postgres pg_dump -U fleetdock -d fleetdock --no-owner | gzip > "$out"
  else
    # Hosted metadata database: dump through the control-plane container,
    # which has pg_dump and the connection string (expanded in the container,
    # hence the single quotes).
    # shellcheck disable=SC2016
    dc exec -T fleetdock sh -c 'pg_dump --no-owner "$FLEETDOCK_DATABASE_URL"' | gzip > "$out"
  fi
  # An empty or truncated dump must not pass as a backup.
  if ! gzip -t "$out" 2>/dev/null || [ "$(gzip -dc "$out" | head -c 1 | wc -c)" -eq 0 ]; then
    rm -f "$out"
    echo "error: metadata backup failed" >&2
    return 1
  fi
}

# is_local reports whether this is an "only this computer" install
# (install.sh --local, and every macOS or WSL install).
is_local() {
  [ "$(getenv FLEETDOCK_MODE)" = "local" ] || [ "$(uname -s)" = "Darwin" ]
}

# sync_db_password makes the bundled Postgres role's password match
# FLEETDOCK_POSTGRES_PASSWORD in .env. Postgres reads POSTGRES_PASSWORD only when
# it first creates its volume, so the two can disagree — an install made before
# docker-compose.yml read the variable has the generated value in .env but
# "fleetdock" in the database, and the control plane could not log in. The
# container's local socket uses trust authentication, so this works whatever
# the old password was, and repeating it changes nothing.
sync_db_password() {
  pw="$(getenv FLEETDOCK_POSTGRES_PASSWORD)"
  [ -n "$pw" ] || return 0
  case "$(getenv FLEETDOCK_DATABASE_URL)" in
    ""|*@postgres:*) ;;
    *) return 0 ;;
  esac
  dc up -d postgres >/dev/null 2>&1 || return 0
  i=0
  until dc exec -T postgres pg_isready -U fleetdock -d fleetdock >/dev/null 2>&1; do
    i=$((i + 1)); [ $i -lt 30 ] || break; sleep 2
  done
  echo "ALTER ROLE fleetdock PASSWORD :'pw';" \
    | dc exec -T postgres psql -U fleetdock -d fleetdock -q -v ON_ERROR_STOP=1 -v pw="$pw" >/dev/null \
    || echo "warning: could not set the metadata database password" >&2
}

need_root() {
  # A local install lives under $HOME and drives Docker as the invoking user
  # (Docker Desktop, or membership of the docker group), so there is nothing
  # to elevate for.
  is_local && return 0
  [ "$(id -u)" = "0" ] || { echo "error: this needs root (try sudo)" >&2; exit 1; }
}

# compose_project resolves the project name the stack runs under, which is what
# labels its volumes.
compose_project() {
  if [ -n "${COMPOSE_PROJECT_NAME:-}" ]; then
    echo "$COMPOSE_PROJECT_NAME"
  else
    grep -m1 '^name:' "${FLEETDOCK_DIR}/docker-compose.yml" 2>/dev/null \
      | awk '{print $2}' | grep . || echo fleetdock
  fi
}

# cli_path finds the installed CLI. install.sh writes it to /usr/local/bin when
# writable and ~/.local/bin otherwise, so neither location can be assumed.
cli_path() {
  for p in /usr/local/bin/fleetdock "${HOME}/.local/bin/fleetdock"; do
    [ -f "$p" ] && { echo "$p"; return; }
  done
  command -v fleetdock 2>/dev/null || true
}

usage() {
  cat <<'EOF'
Usage: fleetdock <command>

  status                Container health and the control plane's readiness
  credentials           Dashboard URL and the bootstrap admin login
  logs [service] [-f]   Tail logs (default: everything)
  start | stop | restart [service]
  update [--tag <tag>]  Pull and restart on a new image tag
  domain <hostname>     Move the dashboard to a new hostname
  port [<n>]            Local installs: show, or change, the dashboard's port
  gateway enable|disable  External database access (adds/removes a port range)
  config get <KEY> | set <KEY> <VALUE>
  env [--reveal]        Show configuration; secrets redacted unless --reveal
  psql                  A psql shell on the metadata database
  backup-db [file]      pg_dump of the metadata database (runs before every update)
  reset-admin-password [email]
                        Set a new password for a dashboard user (default: the
                        bootstrap admin), reactivate it and end its sessions
  shell                 A shell inside the control-plane container
  doctor                Diagnose a broken install
  backup-config         Archive .env and docker-compose.yml
  uninstall             Stop and remove containers, keeping data and config
  delete [--yes]        Remove everything from this host: containers, volumes,
                        images, config and this command. Irreversible.
  version
EOF
}

cmd="${1:-}"
if [ $# -gt 0 ]; then shift; fi

case "$cmd" in
  status)
    dc ps
    echo
    url="$(getenv FLEETDOCK_PUBLIC_URL)"
    if dc exec -T fleetdock wget -qO- http://127.0.0.1:8080/readyz 2>/dev/null | grep -q ready; then
      echo "control plane: ready at ${url}"
    else
      echo "control plane: NOT ready — try: fleetdock logs fleetdock"
    fi
    echo "image tag:     $(getenv FLEETDOCK_RELEASE_TAG)"
    ;;

  credentials)
    email="$(getenv FLEETDOCK_ADMIN_EMAIL)"
    echo "Dashboard  $(getenv FLEETDOCK_PUBLIC_URL)"
    echo "Email      ${email}"
    echo "Password   $(getenv FLEETDOCK_ADMIN_PASSWORD)"
    echo
    # Deliberately not inferred from container logs: `docker compose logs` only
    # covers the current container, so any restart would make a real bootstrap
    # look like it never happened. State the condition instead, and check
    # whether the account exists where that is cheap to do.
    cat <<'EOT'
This is the bootstrap password recorded at install time. It works only if
Fleetdock created this account — the users table has to have been empty on
first boot — and the password has not been changed since.
EOT
    # Only meaningful when the bundled Postgres actually holds the metadata. The
    # service runs regardless, so with a hosted database (FLEETDOCK_DATABASE_URL
    # pointing elsewhere) querying it would report on the wrong database
    # entirely and claim the account does not exist.
    db_url="$(getenv FLEETDOCK_DATABASE_URL)"
    case "${db_url}" in
      ""|*@postgres:*)
        if dc ps --services 2>/dev/null | grep -qx postgres; then
          # The email is passed as a psql variable and quoted by psql (:'email'),
          # never spliced into the SQL text.
          n="$(echo "select count(*) from users where lower(email) = lower(:'email');" \
                | dc exec -T postgres psql -U fleetdock -d fleetdock -tA -v email="${email}" 2>/dev/null \
                | tr -d '[:space:]')"
          case "$n" in
            0) echo; echo "No account with that email exists — sign in with the one that does." ;;
            [1-9]*) echo; echo "An account with that email exists." ;;
          esac
        fi
        ;;
      *) echo; echo "Metadata is on an external database; not checked." ;;
    esac
    ;;

  logs) dc logs --tail 200 "$@" ;;
  start)
    [ $# -gt 0 ] || sync_db_password
    dc up -d "$@"
    ;;
  stop) dc stop "$@" ;;
  restart) dc restart "$@" ;;

  update)
    need_root
    if [ "${1:-}" = "--tag" ]; then
      setenv FLEETDOCK_RELEASE_TAG "${2:?--tag needs a value}"
    fi
    repo="${FLEETDOCK_REPO:-fleetdock/fleetdock}"
    tag="$(getenv FLEETDOCK_RELEASE_TAG)"
    ref="main"
    [ "$tag" != "latest" ] && [ -n "$tag" ] && ref="$tag"
    mkdir -p "${FLEETDOCK_DIR}/backups"
    snap="${FLEETDOCK_DIR}/backups/metadata-pre-update-$(date +%Y%m%d-%H%M%S).sql.gz"
    echo "==> Backing up the metadata database to ${snap}"
    backup_db "$snap" || { echo "error: refusing to update without a metadata backup (override: FLEETDOCK_SKIP_BACKUP=1)" >&2; [ "${FLEETDOCK_SKIP_BACKUP:-}" = "1" ] || exit 1; }
    echo "==> Refreshing stack definition (${ref})"
    curl -fsSL "https://raw.githubusercontent.com/${repo}/${ref}/docker-compose.yml" \
      -o "${FLEETDOCK_DIR}/docker-compose.yml"
    echo "==> Pulling images"
    dc pull -q
    sync_db_password
    echo "==> Restarting"
    dc up -d
    docker image prune -f >/dev/null 2>&1 || true
    echo "Updated. Check with: fleetdock status"
    ;;

  domain)
    need_root
    new="${1:?usage: fleetdock domain <hostname>}"
    old="$(getenv FLEETDOCK_DOMAIN)"
    # A local install has no certificate to get, so a bare name means http.
    default_scheme=https
    is_local && default_scheme=http
    case "$new" in
      http://*) scheme=http; host="${new#http://}" ;;
      https://*) scheme=https; host="${new#https://}" ;;
      *) scheme="$default_scheme"; host="$new" ;;
    esac
    url="${scheme}://${host}"
    bind="$(getenv FLEETDOCK_HTTP_BIND)"
    if is_local && [ -n "$bind" ]; then
      # A local install listens on loopback only while it is "localhost";
      # any other name (a LAN or VPN address) has to be reachable from other
      # machines, so listen on every interface — and back again.
      port="${bind##*:}"
      [ "$port" = 80 ] || url="${url}:${port}"
      if [ "$host" = localhost ]; then
        setenv FLEETDOCK_HTTP_BIND "127.0.0.1:${port}"
      else
        setenv FLEETDOCK_HTTP_BIND "$port"
        echo "Listening on every network interface (port ${port}) so other machines can reach ${host}."
      fi
    fi
    setenv FLEETDOCK_DOMAIN "$host"
    # Caddy listens on 80 inside the container whatever port is published, so
    # the site address never carries the published port.
    setenv FLEETDOCK_SITE_ADDRESS "$([ "$scheme" = http ] && echo "http://${host}" || echo "$host")"
    setenv FLEETDOCK_PUBLIC_URL "$url"
    setenv FLEETDOCK_CORS_ORIGIN "$url"
    dc up -d
    cat <<EOF

Dashboard moved to ${url}.

Two things do NOT move automatically:

  1. Agents already enrolled still point at ${old}. The control plane cannot
     re-point them remotely. On each managed server:

       sudo sed -i 's|^FLEETDOCK_URL=.*|FLEETDOCK_URL=${url}|' \\
         /etc/fleetdock-agent/agent.env && sudo systemctl restart fleetdock-agent

     Until then, keep ${old} resolving to this host.

  2. Database endpoints that already have public access keep the hostname they
     were issued with. They keep working while ${old} resolves here. To adopt
     the new name in issued connection URLs:

       fleetdock psql -c "UPDATE database_endpoints SET external_host='${host}' WHERE external_host='${old}';"

EOF
    ;;

  port)
    bind="$(getenv FLEETDOCK_HTTP_BIND)"
    if ! is_local || [ -z "$bind" ]; then
      echo "This is a server install: it serves on ports 80 and 443." >&2
      exit 1
    fi
    old="${bind##*:}"
    if [ $# -eq 0 ]; then
      echo "$old"
      exit 0
    fi
    new="$1"
    case "$new" in *[!0-9]*|"") echo "usage: fleetdock port <number>" >&2; exit 1 ;; esac
    if [ "$new" -lt 1 ] || [ "$new" -gt 65535 ]; then
      echo "error: a port is between 1 and 65535" >&2; exit 1
    fi
    [ "$new" != "$old" ] || { echo "Already on port ${new}."; exit 0; }
    if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$new" -sTCP:LISTEN >/dev/null 2>&1; then
      echo "error: port ${new} is already in use on this computer" >&2; exit 1
    elif command -v ss >/dev/null 2>&1 && ss -ltnH "sport = :${new}" 2>/dev/null | grep -q .; then
      echo "error: port ${new} is already in use on this computer" >&2; exit 1
    fi
    case "$bind" in
      *:*) setenv FLEETDOCK_HTTP_BIND "${bind%:*}:${new}" ;;
      *) setenv FLEETDOCK_HTTP_BIND "$new" ;;
    esac
    host="$(getenv FLEETDOCK_DOMAIN)"; host="${host:-localhost}"
    url="http://${host}"; [ "$new" = 80 ] || url="${url}:${new}"
    setenv FLEETDOCK_PUBLIC_URL "$url"
    setenv FLEETDOCK_CORS_ORIGIN "$url"
    dc up -d
    echo "Dashboard moved to ${url}"
    ;;

  gateway)
    need_root
    case "${1:-}" in
      enable)
        setenv FLEETDOCK_GATEWAY_ENABLED true
        setenv COMPOSE_PROFILES gateway
        dc --profile gateway up -d
        start="$(getenv FLEETDOCK_GATEWAY_PORT_RANGE_START)"; start="${start:-15432}"
        end="$(getenv FLEETDOCK_GATEWAY_PORT_RANGE_END)"; end="${end:-15481}"
        host="$(getenv FLEETDOCK_GATEWAY_PUBLIC_HOST)"; host="${host:-$(getenv FLEETDOCK_DOMAIN)}"
        cat <<EOF

External database access enabled on ${host}, ports ${start}-${end}.
Open that range in the host firewall, then enable public access per database
from its Connectivity panel.

If ${host} sits behind a CDN proxy (Cloudflare's orange cloud), only 80/443
reach this host and database endpoints will not work. Point a grey-clouded
record here instead and set FLEETDOCK_GATEWAY_PUBLIC_HOST to it.
EOF
        ;;
      disable)
        setenv FLEETDOCK_GATEWAY_ENABLED false
        setenv COMPOSE_PROFILES ""
        dc --profile gateway stop gateway gateway-init 2>/dev/null || true
        dc --profile gateway rm -f gateway gateway-init 2>/dev/null || true
        dc up -d
        echo "External database access disabled. Existing endpoints stop accepting connections."
        ;;
      *) echo "usage: fleetdock gateway enable|disable" >&2; exit 1 ;;
    esac
    ;;

  config)
    case "${1:-}" in
      get)
        key="${2:?usage: fleetdock config get <KEY>}"
        if grep -q "^${key}=" "$ENV_FILE"; then
          getenv "$key"
        else
          case "$key" in
            port|PORT) echo "The dashboard's port: run 'fleetdock port'." >&2 ;;
            *) echo "${key} is not set. 'fleetdock env' lists every setting." >&2 ;;
          esac
          exit 1
        fi
        ;;
      set)
        need_root
        key="${2:?usage: fleetdock config set <KEY> <VALUE>}"
        val="${3?usage: fleetdock config set <KEY> <VALUE>}"
        if [ "$key" = "FLEETDOCK_ENCRYPTION_KEY" ] && [ "${FLEETDOCK_I_UNDERSTAND:-}" != "1" ]; then
          echo "error: changing FLEETDOCK_ENCRYPTION_KEY makes every stored credential unreadable." >&2
          echo "Rotate properly instead (see docs/OPERATIONS.md), or set FLEETDOCK_I_UNDERSTAND=1." >&2
          exit 1
        fi
        setenv "$key" "$val"
        dc up -d
        ;;
      *) echo "usage: fleetdock config get|set <KEY> [VALUE]" >&2; exit 1 ;;
    esac
    ;;

  env)
    if [ "${1:-}" = "--reveal" ]; then
      cat "$ENV_FILE"
    else
      sed -E 's/^(FLEETDOCK_(JWT_SECRET|ENCRYPTION_KEY|ADMIN_PASSWORD|SMTP_PASSWORD))=.*/\1=<redacted>/' "$ENV_FILE"
    fi
    ;;

  psql) dc exec postgres psql -U fleetdock fleetdock "$@" ;;
  shell) dc exec fleetdock sh ;;

  doctor)
    echo "== versions =="
    docker --version
    docker compose version --short
    echo
    echo "== containers =="
    dc ps
    echo
    domain="$(getenv FLEETDOCK_DOMAIN)"
    url="$(getenv FLEETDOCK_PUBLIC_URL)"
    if is_local; then
      # No DNS and no certificate to check: the dashboard is served on this
      # computer only.
      echo "== local install =="
      echo "dashboard:         ${url}"
      echo "listening on:      $(getenv FLEETDOCK_HTTP_BIND || true)"
      echo "  (127.0.0.1:<port> means this computer only; a bare port means every interface)"
    else
      echo "== dns =="
      echo "configured domain: ${domain}"
      resolved="$(getent hosts "$domain" 2>/dev/null | awk '{print $1}' | head -1 || true)"
      public="$(curl -fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)"
      echo "resolves to:       ${resolved:-<unresolved>}"
      echo "this host:         ${public:-<unknown>}"
      if [ -n "$resolved" ] && [ -n "$public" ] && [ "$resolved" != "$public" ]; then
        echo "  MISMATCH — certificate issuance will keep failing"
      fi
    fi
    echo
    echo "== reachability =="
    code="$(curl -fsS -o /dev/null -w '%{http_code}' --max-time 10 "${url}/readyz" 2>/dev/null || echo failed)"
    echo "${url}/readyz -> ${code}"
    echo
    echo "== disk =="
    df -h "$FLEETDOCK_DIR" | tail -1
    ;;

  backup-db)
    need_root
    mkdir -p "${FLEETDOCK_DIR}/backups"
    out="${1:-${FLEETDOCK_DIR}/backups/metadata-$(date +%Y%m%d-%H%M%S).sql.gz}"
    backup_db "$out"
    echo "Wrote ${out}"
    echo "Restore with: gunzip -c ${out} | fleetdock psql"
    echo "Stored credentials inside are encrypted with FLEETDOCK_ENCRYPTION_KEY — keep"
    echo "a copy of .env (fleetdock backup-config) alongside it, or they are unreadable."
    ;;

  reset-admin-password)
    need_root
    email="${1:-$(getenv FLEETDOCK_ADMIN_EMAIL)}"
    [ -n "$email" ] || { echo "usage: fleetdock reset-admin-password <email>" >&2; exit 1; }
    if ! pw="$(dc exec -T fleetdock /api reset-password "$email")"; then
      exit 1
    fi
    echo "New password for ${email}: ${pw}"
    echo "All existing dashboard sessions of this user were signed out."
    ;;

  backup-config)
    need_root
    out="${FLEETDOCK_DIR}/fleetdock-config-$(date +%Y%m%d-%H%M%S).tar.gz"
    tar -czf "$out" -C "$FLEETDOCK_DIR" .env docker-compose.yml
    chmod 600 "$out"
    echo "Wrote ${out}"
    echo "This holds FLEETDOCK_ENCRYPTION_KEY — the only thing that can decrypt stored"
    echo "credentials. Keep it somewhere safe and off this host."
    ;;

  uninstall)
    need_root
    case "${1:-}" in
      --purge) set -- delete ${2:+"$2"}; exec "$0" "$@" ;;
    esac
    dc --profile gateway down
    echo "Stopped. Data and configuration kept in ${FLEETDOCK_DIR}."
    echo "Start again with 'fleetdock start', or remove everything with 'fleetdock delete'."
    ;;

  delete)
    need_root
    project="$(compose_project)"
    cli="$(cli_path)"
    db_url="$(getenv FLEETDOCK_DATABASE_URL)"
    images="$(dc config --images 2>/dev/null | sort -u || true)"
    volumes="$(docker volume ls -q --filter "label=com.docker.compose.project=${project}" 2>/dev/null || true)"

    echo "This permanently removes Fleetdock from this host:"
    echo
    echo "  Containers   $(dc ps -a --format '{{.Name}}' 2>/dev/null | tr '\n' ' ')"
    [ -n "$volumes" ] && echo "  Volumes      $(echo "$volumes" | tr '\n' ' ')"
    [ -n "$images" ]  && echo "  Images       $(echo "$images" | tr '\n' ' ')"
    if [ -e "${FLEETDOCK_DIR}/.git" ] || [ -d "${FLEETDOCK_DIR}/backend" ] || \
       [ -f "${FLEETDOCK_DIR}/Dockerfile" ] || [ "${FLEETDOCK_DIR}" = "${HOME}" ]; then
      echo "  Directory    ${FLEETDOCK_DIR}  (KEPT — looks like a source checkout, not an install)"
    else
      echo "  Directory    ${FLEETDOCK_DIR}"
    fi
    [ -n "$cli" ] && echo "  Command      ${cli}"
    echo
    # The encryption key is the part that cannot be recovered. Losing it while
    # keeping a database backup elsewhere leaves that backup permanently
    # unreadable, so this warning is not boilerplate.
    cat <<EOT
IRREVERSIBLE: ${FLEETDOCK_DIR}/.env holds FLEETDOCK_ENCRYPTION_KEY, the only key
that can decrypt stored database and object-store credentials. Any backup of the
metadata database becomes unreadable without it. Run 'fleetdock backup-config'
first if you might ever rebuild this install.
EOT
    case "${db_url}" in
      ""|*@postgres:*) ;;
      *) echo
         echo "Metadata is on an external database. The data there is NOT deleted —"
         echo "drop it with your provider if you want it gone." ;;
    esac
    cat <<'EOT'

Agents on managed servers are not touched. Remove each one on its own host:

  sudo systemctl disable --now fleetdock-agent
  sudo rm -rf /etc/fleetdock-agent /var/lib/fleetdock-agent \
              /usr/local/bin/fleetdock-agent /etc/systemd/system/fleetdock-agent.service
EOT
    echo
    if [ "${1:-}" != "--yes" ]; then
      printf 'Type DELETE to confirm: '
      # Read from the terminal when there is one — `curl … | sh` leaves stdin
      # bound to the script. With neither, refuse rather than assume consent.
      if [ -r /dev/tty ] && ( : >/dev/tty ) 2>/dev/null; then
        read -r confirm < /dev/tty
      elif [ -t 0 ]; then
        read -r confirm
      else
        echo; echo "Not a terminal — re-run with --yes to confirm non-interactively." >&2
        exit 1
      fi
      [ "$confirm" = "DELETE" ] || { echo "Aborted."; exit 1; }
    fi

    echo "==> Removing containers, networks and volumes"
    dc --profile gateway down -v --remove-orphans 2>&1 | sed 's/^/    /' || true

    if [ -n "$images" ]; then
      echo "==> Removing images"
      # shellcheck disable=SC2086
      echo "$images" | xargs -r docker rmi >/dev/null 2>&1 || true
    fi

    # An install directory holds .env and docker-compose.yml and nothing else.
    # If FLEETDOCK_DIR was pointed at a source checkout or a home directory,
    # rm -rf would take the lot, so leave anything that is clearly not ours.
    if [ -e "${FLEETDOCK_DIR}/.git" ] || [ -d "${FLEETDOCK_DIR}/backend" ] || \
       [ -f "${FLEETDOCK_DIR}/Dockerfile" ] || [ "${FLEETDOCK_DIR}" = "${HOME}" ]; then
      echo "==> Leaving ${FLEETDOCK_DIR} alone — it looks like a source checkout, not an install"
      echo "    Delete .env and docker-compose.yml by hand if you meant to."
    else
      echo "==> Removing ${FLEETDOCK_DIR}"
      rm -rf "$FLEETDOCK_DIR"
    fi

    echo "Fleetdock removed."
    # Last, so nothing else needs to read this script afterwards.
    [ -n "$cli" ] && rm -f "$cli"
    ;;

  version)
    echo "image tag: $(getenv FLEETDOCK_RELEASE_TAG)"
    dc images fleetdock 2>/dev/null | tail -n +2 || true
    ;;

  ""|-h|--help|help) usage ;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 1 ;;
esac
